<!DOCTYPE html>
<html lang="{{ locale }}"{% if theme != 'system' %} data-theme="{{ theme }}"{% endif %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% if refresh_seconds > 0 %}<meta http-equiv="refresh" content="{{ refresh_seconds }}">{% endif %}
    <title>
        {%- if view == 'homework' -%}
            {{ t('homework.title') }}
        {%- elseif view == 'homework_done' -%}
            {{ t('homework.done_title') }}
        {%- elseif view == 'exams' -%}
            {{ t('exams.title') }}
        {%- elseif view == 'absences' -%}
            {{ t('absences.title') }}
        {%- elseif view == 'week' -%}
            {{ t('week.title') }}
        {%- else -%}
            {{ t('title', {day: day_label}) }}
        {%- endif -%}
    </title>
    <link rel="stylesheet" href="{{ asset('assets/style.css') }}">

    <link rel="icon" href="{{ asset('icon.svg') }}" type="image/svg+xml">
    <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="32x32">
    <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">
    <link rel="manifest" href="{{ path('manifest') }}" crossorigin="use-credentials">
    {% if theme == 'dark' %}
        <meta name="theme-color" content="#14171A">
    {% elseif theme == 'light' %}
        <meta name="theme-color" content="#ECEEF0">
    {% else %}
        <meta name="theme-color" content="#ECEEF0" media="(prefers-color-scheme: light)">
        <meta name="theme-color" content="#14171A" media="(prefers-color-scheme: dark)">
    {% endif %}
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="{{ t('app.name') }}">
</head>
<body>
<main class="dashboard">

    <header class="day">
        <h1>
            {%- if view == 'homework' -%}
                {{ t('homework.title') }}
            {%- elseif view == 'homework_done' -%}
                {{ t('homework.done_title') }}
            {%- elseif view == 'exams' -%}
                {{ t('exams.title') }}
            {%- elseif view == 'absences' -%}
                {{ t('absences.title') }}
            {%- elseif view == 'week' -%}
                {{ t('week.title') }}
            {%- else -%}
                {{ day_label }}
            {%- endif -%}
        </h1>

        <nav class="views" aria-label="{{ t('nav.timetable') }}{{ homework_enabled ? ' / ' ~ t('nav.homework') : '' }}{{ exams_enabled ? ' / ' ~ t('nav.exams') : '' }}{{ absences_enabled ? ' / ' ~ t('nav.absences') : '' }}">
            <a class="views__link{{ view in ['timetable', 'week'] ? ' views__link--active' : '' }}"
               href="{{ path('dashboard') }}"
               {%- if view in ['timetable', 'week'] %} aria-current="page"{% endif %}>{{ t('nav.timetable') }}</a>
            {% if homework_enabled %}
                <a class="views__link{{ view in ['homework', 'homework_done'] ? ' views__link--active' : '' }}"
                   href="{{ path('homework') }}"
                   {%- if view in ['homework', 'homework_done'] %} aria-current="page"{% endif %}>{{ t('nav.homework') }}</a>
            {% endif %}
            {% if exams_enabled %}
                <a class="views__link{{ view == 'exams' ? ' views__link--active' : '' }}"
                   href="{{ path('exams') }}"
                   {%- if view == 'exams' %} aria-current="page"{% endif %}>{{ t('nav.exams') }}</a>
            {% endif %}
            {% if absences_enabled %}
                <a class="views__link{{ view == 'absences' ? ' views__link--active' : '' }}"
                   href="{{ path('absences') }}"
                   {%- if view == 'absences' %} aria-current="page"{% endif %}>{{ t('nav.absences') }}</a>
            {% endif %}
        </nav>

        {% if view in ['timetable', 'week'] %}
            <nav class="subviews" aria-label="{{ t('nav.timetable') }}">
                <a class="subviews__link{{ view == 'timetable' ? ' subviews__link--active' : '' }}"
                   href="{{ path('dashboard') }}"
                   {%- if view == 'timetable' %} aria-current="page"{% endif %}>{{ t('nav.day') }}</a>
                <a class="subviews__link{{ view == 'week' ? ' subviews__link--active' : '' }}"
                   href="{{ path('week') }}"
                   {%- if view == 'week' %} aria-current="page"{% endif %}>{{ t('nav.week') }}</a>
            </nav>
        {% endif %}

        {% if view in ['homework', 'homework_done'] %}
            <nav class="subviews" aria-label="{{ t('homework.title') }}">
                <a class="subviews__link{{ view == 'homework' ? ' subviews__link--active' : '' }}"
                   href="{{ path('homework') }}"
                   {%- if view == 'homework' %} aria-current="page"{% endif %}>{{ t('homework.open_tab', {count: homework_open_count}) }}</a>
                <a class="subviews__link{{ view == 'homework_done' ? ' subviews__link--active' : '' }}"
                   href="{{ path('homework_done_list') }}"
                   {%- if view == 'homework_done' %} aria-current="page"{% endif %}>{{ t('homework.done_tab', {count: homework_done_count}) }}</a>
            </nav>
        {% endif %}

        {% if view == 'timetable' %}
            <nav class="pager" aria-label="{{ t('header.pager') }}">
                <a class="pager__link pager__link--prev" rel="prev" href="{{ path('dashboard', {day: previous_day.day}) }}">
                    <span class="pager__arrow" aria-hidden="true">&larr;</span>
                    <span class="pager__label">{{ previous_day.label }}</span>
                </a>
                <a class="pager__link pager__link--next" rel="next" href="{{ path('dashboard', {day: next_day.day}) }}">
                    <span class="pager__label">{{ next_day.label }}</span>
                    <span class="pager__arrow" aria-hidden="true">&rarr;</span>
                </a>
            </nav>

            <p class="day__status{{ changes > 0 ? ' day__status--alert' : '' }}">
                {% if changes == 1 %}
                    {{ t('status.one') }}
                {% elseif changes > 1 %}
                    {{ t('status.many', {count: changes}) }}
                {% else %}
                    {{ t('status.none') }}
                {% endif %}
            </p>
        {% endif %}

        {% if view == 'week' %}
            <nav class="pager" aria-label="{{ t('header.pager') }}">
                <a class="pager__link pager__link--prev" rel="prev" href="{{ path('week', {day: previous_week}) }}">
                    <span class="pager__arrow" aria-hidden="true">&larr;</span>
                    <span class="pager__label">{{ previous_week_label }}</span>
                </a>
                <a class="pager__link pager__link--next" rel="next" href="{{ path('week', {day: next_week}) }}">
                    <span class="pager__label">{{ next_week_label }}</span>
                    <span class="pager__arrow" aria-hidden="true">&rarr;</span>
                </a>
            </nav>
        {% endif %}
    </header>

    <div class="columns">
        {% for student in students %}
            <section class="student" style="--accent: {{ student.accent }}">
                <h2>{{ student.name }}</h2>

                {% if student.error %}
                    <p class="problem">
                        {{ t('student.error', {message: student.error}) }}
                    </p>
                {% elseif view == 'homework' %}
                    {% if student.homework_open is empty %}
                        <p class="empty">{{ t('homework.none') }}</p>
                    {% else %}
                        <ol class="homework">
                            {% for task in student.homework_open %}
                                <li class="homework__item">
                                    <form method="post" action="{{ path('homework_done', {id: task.id}) }}" class="homework__check-form">
                                        <button type="submit" class="homework__check" aria-label="{{ t('homework.mark_done') }}"></button>
                                    </form>
                                    <div class="homework__body">
                                        <div class="homework__head">
                                            <span class="homework__subject">{{ task.subject }}</span>
                                            <span class="homework__due{{ task.overdue ? ' homework__due--overdue' : '' }}">{{ t('homework.due', {date: task.due}) }}</span>
                                        </div>
                                        <p class="homework__text">{{ task.text }}</p>
                                        {% if task.remark %}
                                            <p class="homework__remark">{{ task.remark }}</p>
                                        {% endif %}
                                    </div>
                                </li>
                            {% endfor %}
                        </ol>
                    {% endif %}
                {% elseif view == 'homework_done' %}
                    {% if student.homework_done is empty %}
                        <p class="empty">{{ t('homework.none_done') }}</p>
                    {% else %}
                        <ol class="homework homework--done">
                            {% for task in student.homework_done %}
                                <li class="homework__item homework__item--done">
                                    <form method="post" action="{{ path('homework_open', {id: task.id}) }}" class="homework__check-form">
                                        <button type="submit" class="homework__check homework__check--done" aria-label="{{ t('homework.mark_open') }}">✓</button>
                                    </form>
                                    <div class="homework__body">
                                        <div class="homework__head">
                                            <span class="homework__subject">{{ task.subject }}</span>
                                            <span class="homework__due">{{ t('homework.due', {date: task.due}) }}</span>
                                        </div>
                                        <p class="homework__text">{{ task.text }}</p>
                                        {% if task.remark %}
                                            <p class="homework__remark">{{ task.remark }}</p>
                                        {% endif %}
                                    </div>
                                </li>
                            {% endfor %}
                        </ol>
                    {% endif %}
                {% elseif view == 'exams' %}
                    {% if student.exams is empty %}
                        <p class="empty">{{ t('exams.none') }}</p>
                    {% else %}
                        <ol class="exams">
                            {% for exam in student.exams %}
                                <li class="exam">
                                    <div class="exam__head">
                                        <span class="exam__subject">{{ exam.subject }}</span>
                                        <span class="exam__date">{{ t('exams.on', {date: exam.date}) }}</span>
                                    </div>
                                    <p class="exam__meta">
                                        {% if exam.type is not empty and exam.name is not empty %}
                                            <span>{{ exam.type }} – {{ exam.name }}</span>
                                        {% elseif exam.type is not empty or exam.name is not empty %}
                                            <span>{{ exam.type }}{{ exam.name }}</span>
                                        {% endif %}
                                        <span>{{ exam.start }}–{{ exam.end }}</span>
                                        {% if exam.teachers is not empty %}
                                            <span>{{ exam.teachers|join(', ') }}</span>
                                        {% endif %}
                                        {% if exam.rooms is not empty %}
                                            <span class="exam__room">{{ exam.rooms|join(', ') }}</span>
                                        {% endif %}
                                    </p>
                                    {% if exam.text %}
                                        <p class="exam__text">{{ exam.text }}</p>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ol>
                    {% endif %}
                {% elseif view == 'absences' %}
                    {% if student.absences is empty %}
                        <p class="empty">{{ t('absences.none') }}</p>
                    {% else %}
                        <p class="absences__summary">{{ t('absences.summary', {excused: student.absences_excused_count, unexcused: student.absences_unexcused_count}) }}</p>
                        <ol class="absences">
                            {% for absence in student.absences %}
                                <li class="absence">
                                    <div class="absence__head">
                                        <span class="absence__date">
                                            {% if absence.same_day %}
                                                {{ absence.start_date }}
                                            {% else %}
                                                {{ t('absences.range', {from: absence.start_date, to: absence.end_date}) }}
                                            {% endif %}
                                        </span>
                                        <span class="absence__excused{{ absence.excused ? '' : ' absence__excused--no' }}">
                                            {{ absence.excused ? t('absences.excused') : t('absences.unexcused') }}
                                        </span>
                                    </div>
                                    <p class="absence__meta">
                                        <span>{{ absence.start_time }}–{{ absence.end_time }}</span>
                                        {% if absence.reason %}
                                            <span>{{ absence.reason }}</span>
                                        {% endif %}
                                    </p>
                                    {% if absence.text %}
                                        <p class="absence__text">{{ absence.text }}</p>
                                    {% endif %}
                                    {% if absence.created_by or absence.excused_by %}
                                        <p class="absence__by">
                                            {% if absence.created_by %}
                                                <span>{{ t('absences.entered_by', {user: absence.created_by}) }}</span>
                                            {% endif %}
                                            {% if absence.excused_by %}
                                                <span>{{ t('absences.excused_by', {user: absence.excused_by}) }}</span>
                                            {% endif %}
                                        </p>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ol>
                    {% endif %}
                {% elseif view == 'week' %}
                    <div class="week">
                        {% for day in days %}
                            <div class="week__day">
                                <h3 class="week__day-label">{{ day.label }}</h3>
                                {% set dayLessons = student.by_date[day.date] %}
                                {% if dayLessons is empty %}
                                    <p class="week__empty">{{ t('week.empty') }}</p>
                                {% else %}
                                    <ol class="week__lessons">
                                        {% for entry in dayLessons %}
                                            {% set lesson = entry.lesson %}
                                            <li class="week__lesson{{ lesson.isCancelled ? ' week__lesson--cancelled' : '' }}{{ lesson.isSubstituted ? ' week__lesson--shifted' : '' }}{{ entry.current ? ' week__lesson--now' : '' }}">
                                                <span class="week__lesson-time">{{ lesson.start }}</span>
                                                <span class="week__lesson-subject">
                                                    {{ lesson.subject }}
                                                    {% if lesson.isCancelled %}
                                                        <span class="week__lesson-flag">({{ t('lesson.cancelled') }})</span>
                                                    {% elseif lesson.isSubstituted %}
                                                        <span class="week__lesson-flag">({{ t('lesson.substitution') }})</span>
                                                    {% endif %}
                                                </span>
                                                {% if lesson.rooms is not empty %}
                                                    <span class="week__lesson-room">{{ lesson.roomLine }}</span>
                                                {% endif %}
                                            </li>
                                        {% endfor %}
                                    </ol>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% elseif student.lessons is empty %}
                    <p class="empty">{{ t('student.empty') }}</p>
                {% else %}
                    <ol class="lessons">
                        {% for entry in student.entries %}
                            {% if entry.type == 'gap' %}
                                <li class="gap{{ entry.current ? ' gap--now' : '' }}">{{ t('lesson.free', {time: entry.until}) }}</li>
                            {% else %}
                                {% set lesson = entry.lesson %}
                                <li class="lesson{{ lesson.isCancelled ? ' lesson--cancelled' : '' }}{{ lesson.isSubstituted ? ' lesson--shifted' : '' }}{{ entry.current ? ' lesson--now' : '' }}">
                                    <div class="lesson__time">
                                        <span class="lesson__start">{{ lesson.start }}</span>
                                        <span class="lesson__end">{{ lesson.end }}</span>
                                    </div>
                                    <div class="lesson__body">
                                        <h3 class="lesson__subject">
                                            {{ lesson.subject }}
                                            {% if entry.current %}<span class="lesson__now">{{ t('lesson.now') }}</span>{% endif %}
                                        </h3>

                                        <p class="lesson__meta">
                                            {% if lesson.teachers is not empty %}
                                                <span>{{ lesson.teacherLine }}</span>
                                            {% endif %}
                                            {% if lesson.rooms is not empty %}
                                                <span class="lesson__room">{{ lesson.roomLine }}</span>
                                            {% endif %}
                                        </p>

                                        {% if lesson.isCancelled %}
                                            <p class="lesson__flag">{{ t('lesson.cancelled') }}</p>
                                        {% elseif lesson.isSubstituted %}
                                            {% if lesson.replacedTeachers is not empty %}
                                                <p class="lesson__flag">{{ t('lesson.substitution_for', {teachers: lesson.replacedTeachers|join(', ')}) }}</p>
                                            {% endif %}
                                            {% if lesson.replacedRooms is not empty %}
                                                <p class="lesson__flag">{{ t('lesson.room_change', {rooms: lesson.replacedRooms|join(', ')}) }}</p>
                                            {% endif %}
                                            {% if lesson.replacedTeachers is empty and lesson.replacedRooms is empty %}
                                                <p class="lesson__flag">{{ t('lesson.substitution') }}</p>
                                            {% endif %}
                                        {% endif %}

                                        {% for note in lesson.notes %}
                                            <p class="lesson__note">{{ note }}</p>
                                        {% endfor %}
                                    </div>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ol>
                {% endif %}
            </section>
        {% endfor %}
    </div>

    <footer class="site-foot">
        <p class="site-foot__updated">
            {{ t('footer.updated', {time: updated_at}) }}
            {% if from_cache %}
                <span class="site-foot__cache">({{ t('footer.cached', {minutes: cache_minutes_left}) }})</span>
            {% endif %}
            {% if view == 'week' %}
                {% if not is_current_week %}
                    <span aria-hidden="true">·</span>
                    <a href="{{ path('week') }}">{{ t('footer.this_week') }}</a>
                {% endif %}
            {% elseif not is_today %}
                <span aria-hidden="true">·</span>
                <a href="{{ path('dashboard') }}">{{ t('footer.today') }}</a>
            {% endif %}
        </p>
        {% if admin_token %}
            <hr class="site-foot__rule">
            <p class="site-foot__admin">
                <a href="{{ path('admin', {token: admin_token}) }}">{{ t('footer.admin') }}</a>
            </p>
        {% endif %}
        <hr class="site-foot__rule">
        <p class="site-foot__tagline">{{ t('footer.tagline', {heart: '<span class="site-foot__heart" aria-hidden="true">♥</span>'})|raw }}</p>
        <p class="site-foot__meta">
            <a href="https://github.com/sense-design/webuntis-dashboard" target="_blank" rel="noopener">{{ t('footer.source') }}</a>
            <span aria-hidden="true">·</span>
            <a href="https://sense-design.de" target="_blank" rel="noopener">{{ t('footer.author', {name: 'Sven Culley'}) }}</a>
            <span aria-hidden="true">·</span>
            {{ t('footer.license') }}
        </p>
    </footer>

</main>
</body>
</html>
