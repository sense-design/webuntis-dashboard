<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% if refresh_seconds > 0 %}<meta http-equiv="refresh" content="{{ refresh_seconds }}">{% endif %}
    <title>
        {%- if view == 'homework' -%}
            {{ t('homework.title') }}
        {%- elseif view == 'exams' -%}
            {{ t('exams.title') }}
        {%- else -%}
            {{ t('title', {day: day_label}) }}
        {%- endif -%}
    </title>
    <link rel="stylesheet" href="{{ asset('assets/style.css') }}">

    <link rel="icon" href="{{ asset('icon.svg') }}" type="image/svg+xml">
    <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="32x32">
    <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">
    <link rel="manifest" href="{{ path('manifest') }}" crossorigin="use-credentials">
    <meta name="theme-color" content="#ECEEF0">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="{{ t('app.name') }}">
</head>
<body>
<main class="dashboard">

    <header class="day">
        <h1>
            {%- if view == 'homework' -%}
                {{ t('homework.title') }}
            {%- elseif view == 'exams' -%}
                {{ t('exams.title') }}
            {%- else -%}
                {{ day_label }}
            {%- endif -%}
        </h1>

        {% if homework_enabled or exams_enabled %}
            <nav class="views" aria-label="{{ t('nav.timetable') }}{{ homework_enabled ? ' / ' ~ t('nav.homework') : '' }}{{ exams_enabled ? ' / ' ~ t('nav.exams') : '' }}">
                <a class="views__link{{ view == 'timetable' ? ' views__link--active' : '' }}"
                   href="{{ path('dashboard') }}"
                   {%- if view == 'timetable' %} aria-current="page"{% endif %}>{{ t('nav.timetable') }}</a>
                {% if homework_enabled %}
                    <a class="views__link{{ view == 'homework' ? ' views__link--active' : '' }}"
                       href="{{ path('homework') }}"
                       {%- if view == 'homework' %} aria-current="page"{% endif %}>{{ t('nav.homework') }}</a>
                {% endif %}
                {% if exams_enabled %}
                    <a class="views__link{{ view == 'exams' ? ' views__link--active' : '' }}"
                       href="{{ path('exams') }}"
                       {%- if view == 'exams' %} aria-current="page"{% endif %}>{{ t('nav.exams') }}</a>
                {% endif %}
            </nav>
        {% endif %}

        {% if view == 'timetable' %}
            <nav class="pager" aria-label="{{ t('header.pager') }}">
                <a class="pager__link pager__link--prev" rel="prev" href="{{ path('dashboard', {day: previous_day.day}) }}">
                    <span class="pager__arrow" aria-hidden="true">&larr;</span>
                    <span class="pager__label">{{ previous_day.label }}</span>
                </a>
                <a class="pager__link pager__link--next" rel="next" href="{{ path('dashboard', {day: next_day.day}) }}">
                    <span class="pager__label">{{ next_day.label }}</span>
                    <span class="pager__arrow" aria-hidden="true">&rarr;</span>
                </a>
            </nav>

            <p class="day__status{{ changes > 0 ? ' day__status--alert' : '' }}">
                {% if changes == 1 %}
                    {{ t('status.one') }}
                {% elseif changes > 1 %}
                    {{ t('status.many', {count: changes}) }}
                {% else %}
                    {{ t('status.none') }}
                {% endif %}
            </p>
        {% endif %}
    </header>

    <div class="columns">
        {% for student in students %}
            <section class="student" style="--accent: {{ student.accent }}">
                <h2>{{ student.name }}</h2>

                {% if student.error %}
                    <p class="problem">
                        {{ t('student.error', {message: student.error}) }}
                    </p>
                {% elseif view == 'homework' %}
                    {% if student.homework is empty %}
                        <p class="empty">{{ t('homework.none') }}</p>
                    {% else %}
                        <ol class="homework">
                            {% for task in student.homework %}
                                <li class="homework__item">
                                    <div class="homework__head">
                                        <span class="homework__subject">{{ task.subject }}</span>
                                        <span class="homework__due{{ task.overdue ? ' homework__due--overdue' : '' }}">{{ t('homework.due', {date: task.due}) }}</span>
                                    </div>
                                    <p class="homework__text">{{ task.text }}</p>
                                    {% if task.remark %}
                                        <p class="homework__remark">{{ task.remark }}</p>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ol>
                    {% endif %}
                {% elseif view == 'exams' %}
                    {% if student.exams is empty %}
                        <p class="empty">{{ t('exams.none') }}</p>
                    {% else %}
                        <ol class="exams">
                            {% for exam in student.exams %}
                                <li class="exam">
                                    <div class="exam__head">
                                        <span class="exam__subject">{{ exam.subject }}</span>
                                        <span class="exam__date">{{ t('exams.on', {date: exam.date}) }}</span>
                                    </div>
                                    <p class="exam__meta">
                                        {% if exam.type is not empty and exam.name is not empty %}
                                            <span>{{ exam.type }} – {{ exam.name }}</span>
                                        {% elseif exam.type is not empty or exam.name is not empty %}
                                            <span>{{ exam.type }}{{ exam.name }}</span>
                                        {% endif %}
                                        <span>{{ exam.start }}–{{ exam.end }}</span>
                                        {% if exam.teachers is not empty %}
                                            <span>{{ exam.teachers|join(', ') }}</span>
                                        {% endif %}
                                        {% if exam.rooms is not empty %}
                                            <span class="exam__room">{{ exam.rooms|join(', ') }}</span>
                                        {% endif %}
                                    </p>
                                    {% if exam.text %}
                                        <p class="exam__text">{{ exam.text }}</p>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ol>
                    {% endif %}
                {% elseif student.lessons is empty %}
                    <p class="empty">{{ t('student.empty') }}</p>
                {% else %}
                    <ol class="lessons">
                        {% for entry in student.entries %}
                            {% if entry.type == 'gap' %}
                                <li class="gap">{{ t('lesson.free', {time: entry.until}) }}</li>
                            {% else %}
                                {% set lesson = entry.lesson %}
                                <li class="lesson{{ lesson.isCancelled ? ' lesson--cancelled' : '' }}{{ lesson.code == 'irregular' ? ' lesson--shifted' : '' }}">
                                    <div class="lesson__time">
                                        <span class="lesson__start">{{ lesson.start }}</span>
                                        <span class="lesson__end">{{ lesson.end }}</span>
                                    </div>
                                    <div class="lesson__body">
                                        <h3 class="lesson__subject">{{ lesson.subject }}</h3>

                                        <p class="lesson__meta">
                                            {% if lesson.teachers is not empty %}
                                                <span>{{ lesson.teacherLine }}</span>
                                            {% endif %}
                                            {% if lesson.rooms is not empty %}
                                                <span class="lesson__room">{{ lesson.roomLine }}</span>
                                            {% endif %}
                                        </p>

                                        {% if lesson.isCancelled %}
                                            <p class="lesson__flag">{{ t('lesson.cancelled') }}</p>
                                        {% elseif lesson.code == 'irregular' %}
                                            <p class="lesson__flag">
                                                {% if lesson.replacedTeachers is not empty %}
                                                    {{ t('lesson.substitution_for', {teachers: lesson.replacedTeachers|join(', ')}) }}
                                                {% else %}
                                                    {{ t('lesson.substitution') }}
                                                {% endif %}
                                            </p>
                                        {% endif %}

                                        {% for note in lesson.notes %}
                                            <p class="lesson__note">{{ note }}</p>
                                        {% endfor %}
                                    </div>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ol>
                {% endif %}
            </section>
        {% endfor %}
    </div>

    <footer class="site-foot">
        <p class="site-foot__updated">
            {{ t('footer.updated', {time: updated_at}) }}
            {% if not is_today %}
                <span aria-hidden="true">·</span>
                <a href="{{ path('dashboard') }}">{{ t('footer.today') }}</a>
            {% endif %}
        </p>
        {% if admin_token %}
            <hr class="site-foot__rule">
            <p class="site-foot__admin">
                <a href="{{ path('admin', {token: admin_token}) }}">{{ t('footer.admin') }}</a>
            </p>
        {% endif %}
        <hr class="site-foot__rule">
        <p class="site-foot__tagline">{{ t('footer.tagline', {heart: '<span class="site-foot__heart" aria-hidden="true">♥</span>'})|raw }}</p>
        <p class="site-foot__meta">
            <a href="https://github.com/sense-design/webuntis-dashboard" target="_blank" rel="noopener">{{ t('footer.source') }}</a>
            <span aria-hidden="true">·</span>
            <a href="https://sense-design.de" target="_blank" rel="noopener">{{ t('footer.author', {name: 'Sven Culley'}) }}</a>
            <span aria-hidden="true">·</span>
            {{ t('footer.license') }}
        </p>
    </footer>

</main>
</body>
</html>
