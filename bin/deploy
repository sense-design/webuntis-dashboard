#!/bin/sh
# Bare-metal update: pull, install production dependencies, rebuild the cache.
#
#   bin/deploy
#
# Run it from the checkout as the user that owns it (not root). Everything
# else in var/ - admin settings, homework marks, the push key and
# subscriptions - is left alone; only var/cache/ is cleared and warmed up
# again (bin/warmup), so the first request does not pay for it.
#
# No sudo needed once var/ has the ACLs from "Deployment" in README.md: then
# whatever this user writes into var/cache/ stays writable for PHP-FPM too.
# Without them the warmup runs via `sudo -u $WEB_USER`, so the cache never
# ends up owned by a user PHP-FPM cannot write as.
#
# WEB_USER     PHP-FPM user (default www-data).
# FPM_SERVICE  systemd unit to reload afterwards, e.g. php8.3-fpm. Only needed
#              if OPcache runs with validate_timestamps=0.
set -eu

cd "$(dirname "$0")/.."
web_user="${WEB_USER:-www-data}"

if ! grep -qs '^APP_ENV=prod' .env.local; then
    echo "Warning: .env.local does not set APP_ENV=prod - running in dev mode." >&2
fi

git pull --ff-only
composer install --no-dev --optimize-autoloader --no-interaction

# Runs a command as the PHP-FPM user: directly if this already is that user
# or var/cache/ carries a default ACL granting it write access, via sudo
# otherwise.
as_web_user() {
    if [ "$(id -un)" = "$web_user" ] \
        || getfacl -p var/cache 2>/dev/null | grep -q "^default:user:$web_user:rwx"; then
        "$@"
    else
        sudo -u "$web_user" "$@"
    fi
}

mkdir -p var/cache
if ! rm -rf var/cache/* 2>/dev/null; then
    echo "Cannot clear var/cache as $(id -un), retrying as $web_user." >&2
    sudo -u "$web_user" rm -rf var/cache/*
fi
as_web_user php bin/warmup

if [ -n "${FPM_SERVICE:-}" ]; then
    sudo systemctl reload "$FPM_SERVICE"
fi

echo "Deployed $(git rev-parse --short HEAD)."
