# Copy to .env.docker and fill in (docker-compose.yml reads it via
# `env_file:`). Not the same file as the app's own .env / .env.local -
# those are for the bare-metal deployment; Docker gets its APP_SECRET
# straight from the container environment instead.

# Generate with: openssl rand -hex 16
APP_SECRET=

# Seconds between two timetable change checks for push notifications
# (bin/check-changes). 0 switches the check off. Default: 300.
# CHECK_CHANGES_INTERVAL=300
