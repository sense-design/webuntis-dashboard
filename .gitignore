# WebUntis credentials and the /setup token. Copy config/untis.yaml.dist to
# config/untis.yaml and fill it in; the real file never goes into git.
/config/untis.yaml

# docker-compose's APP_SECRET. Copy .env.docker.dist to .env.docker and fill
# it in; the real file never goes into git.
/.env.docker

