# Copy to config/untis.yaml and fill in. That file is gitignored.

# Host part of your school's WebUntis URL, without https://
server: nessa.webuntis.com

# School login name, exactly as it appears in the WebUntis URL or QR code.
school: my-school

timezone: Europe/Berlin

# UI language for the whole app: en or de. Overridable at runtime from
# /admin (see admin_token below); the saved value then wins over this one.
locale: en

# Light/dark appearance: system (follow the browser's own setting), light
# or dark. Overridable at runtime from /admin.
theme: system

# How long a fetched day is reused before WebUntis is asked again.
# Overridable at runtime from /admin.
cache_ttl: 300

# Browser auto-reload interval. Set to 0 to switch it off.
# Overridable at runtime from /admin.
refresh_seconds: 600

# Every feature below is on by default; list only the ones to switch off.
# Disabled views 404 rather than render empty, and the header tabs drop
# to match. Overridable at runtime from /admin.
# features:
#     homework: false
#     exams: false
#     free_periods: false

# Token that unlocks the /setup/<account-id> helper: call it as
# /setup/<account-id>?token=<this value>. Without a match the route 404s.
# Generate one with: openssl rand -hex 16
setup_token: 'change-me'

# Token that unlocks the /admin settings form (locale, cache/refresh timing,
# features): call it as /admin?token=<this value>. Without a match the route
# 404s. Saves go to var/settings.yaml, never back into this file - accounts,
# students and every other key here stay a manual edit. Generate one with:
# openssl rand -hex 16
admin_token: 'change-me'

# One entry per WebUntis login. A parent account with two children needs
# one entry; two separate student logins need two.
accounts:
    - id: parent
      method: secret          # secret (recommended) or password
      user: erika.musterfrau
      secret: 'ABCDEFGHIJKLMNOP'

    # - id: mila
    #   method: password
    #   user: mila.musterfrau
    #   password: 'secret'

# One entry per student shown on the dashboard, in display order.
students:
    - name: Mila
      account: parent
      # element_id comes from /setup/<account-id>. Leave it out when the
      # account itself is the student.
      element_id: 1234
      # WebUntis lists every parallel course of a year group for a student
      # (Religion vs. Praktische Philosophie, the AG slot, ...). List the
      # subjects this student does not attend, exactly as they show on the
      # dashboard, and they are dropped. Easier done from /admin, which
      # shows this student's actual subjects as a checklist rather than
      # requiring the exact string here; see "Changing settings without
      # editing the config" in the README.
      # hide_subjects: ['07_ER', 'AG_Garten']

    - name: Jonas
      account: parent
      element_id: 5678
